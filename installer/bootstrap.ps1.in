# Versioned online entry point. Published alongside the exact checked bundle.
[CmdletBinding()]
param([ValidateSet('check','install','update','repair','rollback','launch','uninstall')][string]$Action='install',
 [string]$Root='', [switch]$Local, [switch]$AcceptModelTerms, [switch]$Yes,
 [switch]$RemoveModels, [switch]$RemoveKey, [switch]$SaveOpenRouterKey)
$ErrorActionPreference='Stop'
$temporary=Join-Path ([IO.Path]::GetTempPath()) ('ewp-download-'+[Guid]::NewGuid())
New-Item -ItemType Directory -Path $temporary|Out-Null
try {
 $archive=Join-Path $temporary 'bundle.zip'
 Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/Polikles/ewp-transcripts/releases/download/v@VERSION@/EwP-@VERSION@-windows-x64.zip' -OutFile $archive
 if((Get-FileHash -Algorithm SHA256 -LiteralPath $archive).Hash.ToLowerInvariant() -ne '@WINDOWS_SHA@'){throw 'Installer bundle hash mismatch; nothing was installed.'}
 Expand-Archive -LiteralPath $archive -DestinationPath (Join-Path $temporary 'payload')
 $options=@{Action=$Action;Bundle=$archive;Local=$Local;AcceptModelTerms=$AcceptModelTerms;Yes=$Yes;RemoveModels=$RemoveModels;RemoveKey=$RemoveKey;SaveOpenRouterKey=$SaveOpenRouterKey}
 if($Root){$options.Root=$Root}
 & (Join-Path $temporary 'payload/control/Install-EwP.ps1') @options
 $code=$LASTEXITCODE
} finally {Remove-Item -LiteralPath $temporary -Recurse -Force}
exit $code
